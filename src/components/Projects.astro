---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-4xl sm:text-5xl md:text-6xl xl:text-8xl font-bold text-white uppercase tracking-tighter">
              Projects
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
            <p class="mt-6 text-sm text-gray-500 italic">
              Most photos and video on this page were shot and edited by me.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-10">
              {siteConfig.projects.map((project, index) => {
                const media = project.media || [];
                const lead = media[0];
                const rest = media.slice(1);

                return (
                  <div class="group relative p-4 sm:p-6 md:p-8 bg-white/[0.04] rounded-xl sm:rounded-2xl border border-white/10 transition-all duration-300 hover:border-white/25">
                    <div class="space-y-4">
                      <div class="flex items-start justify-between gap-4">
                        <div>
                          <span
                            class="text-sm font-mono"
                            style={{ color: siteConfig.accentColor }}
                          >
                            0{index + 1}
                          </span>
                          <h3 class="text-xl sm:text-2xl font-bold text-white mt-1">
                            {project.name}
                          </h3>
                        </div>
                        {project.link && (
                          <a
                            href={project.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`View ${project.name}`}
                            class="shrink-0 w-10 h-10 sm:w-11 sm:h-11 flex items-center justify-center bg-white/10 border border-white/10 rounded-full text-white transition-all duration-300 hover:-translate-y-0.5 hover:border-transparent hover:bg-[var(--accent-color)]"
                            style={`--accent-color: ${siteConfig.accentColor}`}
                          >
                            <svg
                              class="w-4 h-4 sm:w-4.5 sm:h-4.5"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M7 17L17 7M17 7H7M17 7V17"
                              />
                            </svg>
                          </a>
                        )}
                      </div>

                      <p class="text-base sm:text-lg text-gray-400 leading-relaxed">
                        {project.description}
                      </p>

                      {project.comingSoon && (
                        <div class="rounded-lg border border-dashed border-white/20 bg-black/40 px-4 py-6 sm:px-6 sm:py-8 flex flex-col items-center justify-center text-center gap-2">
                          <span
                            class="text-xs font-mono uppercase tracking-widest px-3 py-1 rounded-full border"
                            style={{
                              color: siteConfig.accentColor,
                              borderColor: siteConfig.accentColor,
                            }}
                          >
                            PhD thesis &middot; not yet public
                          </span>
                          <p class="text-sm text-gray-500 max-w-md">
                            Write-up and media coming soon.
                          </p>
                        </div>
                      )}

                      {lead && (
                        <div class="rounded-lg overflow-hidden bg-black aspect-video">
                          {lead.type === "video" && (
                            <video
                              src={lead.src}
                              class="w-full h-full object-contain"
                              controls
                              loop
                              muted
                              playsinline
                              preload="metadata"
                            />
                          )}
                          {lead.type === "image" && (
                            <img
                              src={lead.src}
                              alt={lead.caption || project.name}
                              class="w-full h-full object-contain"
                              loading="lazy"
                            />
                          )}
                          {lead.type === "youtube" && (
                            <iframe
                              class="w-full h-full"
                              src={`https://www.youtube.com/embed/${lead.id}`}
                              title={lead.caption || project.name}
                              frameborder="0"
                              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                              allowfullscreen
                              loading="lazy"
                            />
                          )}
                        </div>
                      )}
                      {lead?.caption && (
                        <p class="text-xs sm:text-sm text-gray-500 -mt-2">
                          {lead.caption}
                        </p>
                      )}

                      {rest.length > 0 && (
                        <div
                          class={`grid gap-3 ${rest.length > 1 ? "sm:grid-cols-2" : "grid-cols-1"}`}
                        >
                          {rest.map((m) => (
                            <figure class="m-0">
                              <div class="rounded-lg overflow-hidden bg-black aspect-video flex items-center justify-center">
                                {m.type === "video" && (
                                  <video
                                    src={m.src}
                                    class="w-full h-full object-contain"
                                    controls
                                    loop
                                    muted
                                    playsinline
                                    preload="metadata"
                                  />
                                )}
                                {m.type === "image" && (
                                  <img
                                    src={m.src}
                                    alt={m.caption || project.name}
                                    class="w-full h-full object-contain"
                                    loading="lazy"
                                  />
                                )}
                                {m.type === "youtube" && (
                                  <iframe
                                    class="w-full h-full"
                                    src={`https://www.youtube.com/embed/${m.id}`}
                                    title={m.caption || project.name}
                                    frameborder="0"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                    allowfullscreen
                                    loading="lazy"
                                  />
                                )}
                              </div>
                              {m.caption && (
                                <figcaption class="mt-1.5 text-xs sm:text-sm text-gray-500">
                                  {m.caption}
                                </figcaption>
                              )}
                            </figure>
                          ))}
                        </div>
                      )}

                      {project.skills && project.skills.length > 0 && (
                        <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                          {project.skills.map((skill) => (
                            <span class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-white/5 border border-white/10 text-gray-200 rounded-md sm:rounded-lg text-xs sm:text-sm font-medium">
                              {skill}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>

        {siteConfig.sideProjects && siteConfig.sideProjects.length > 0 && (
          <div
            id="side-projects"
            class="relative mt-16 sm:mt-20 md:mt-24 -mx-8 sm:-mx-12 md:-mx-16 lg:-mx-24 px-8 sm:px-12 md:px-16 lg:px-24 py-10 sm:py-12 md:py-16 border-t border-white/10"
            style={`--accent-color: ${siteConfig.accentColor}; background: linear-gradient(120deg, var(--accent-color) 0%, #2a0a45 45%, #0a0a0a 100%)`}
          >
            <h3 class="text-xs sm:text-sm font-mono uppercase tracking-[0.3em] text-white/70 mb-6 sm:mb-8">
              Side Projects
            </h3>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
              {siteConfig.sideProjects.map((project) => {
                const lead = (project.media || [])[0];

                return (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group block bg-black/40 backdrop-blur-sm rounded-lg sm:rounded-xl border border-white/15 p-2.5 sm:p-3 transition-colors duration-300 hover:border-white/35"
                  >
                    {lead && (
                      <div class="rounded-md overflow-hidden bg-black aspect-square mb-2.5">
                        {lead.type === "video" && (
                          <video src={lead.src} class="w-full h-full object-cover" muted loop playsinline preload="metadata" />
                        )}
                        {lead.type === "image" && (
                          <img src={lead.src} alt={project.name} class="w-full h-full object-cover" loading="lazy" />
                        )}
                        {lead.type === "youtube" && (
                          <img
                            src={`https://img.youtube.com/vi/${lead.id}/hqdefault.jpg`}
                            alt={project.name}
                            class="w-full h-full object-cover"
                            loading="lazy"
                          />
                        )}
                      </div>
                    )}
                    <h4 class="text-xs sm:text-sm font-bold text-white leading-tight">
                      {project.name}
                    </h4>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </section>
  )
}
