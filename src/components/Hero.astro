---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-[#0a0a0a] py-24 md:h-screen"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <!-- Gradient overlay -->
  <div
    id="hero-glow"
    class="absolute inset-0 -z-10"
    style={`background: radial-gradient(ellipse 900px 1300px at 0% 0%, ${siteConfig.accentColor}55 0%, ${siteConfig.accentColor}25 25%, ${siteConfig.accentColor}08 45%, transparent 65%), #0a0a0a`}
  >
  </div>
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-white/10 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
  >
    <defs>
      <pattern
        x="50%"
        y={-1}
        id="0787a7c5-978c-4f66-83c7-11c213f99cb7"
        width={200}
        height={200}
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 200V.5H200" fill="none"></path>
      </pattern>
    </defs>
    <rect
      fill="url(#0787a7c5-978c-4f66-83c7-11c213f99cb7)"
      width="100%"
      height="100%"
      stroke-width={0}></rect>
  </svg>
  <canvas
    id="hero-field"
    data-accent={siteConfig.accentColor}
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
  ></canvas>
  <div class="h-full mx-auto p-8 sm:p-12 md:p-24 flex items-center">
    <div>
      <h1
        id="hero-name"
        class="text-pretty text-5xl sm:text-6xl md:text-7xl lg:text-9xl font-bold tracking-tighter text-white"
        style="opacity:0"
      >
        I'm <span style={{ color: siteConfig.accentColor }}
          >{siteConfig.firstName}</span
        >
      </h1>
      <p
        id="hero-tagline"
        class="mt-4 sm:mt-6 md:mt-8 text-pretty text-base sm:text-lg md:text-xl/8 font-medium text-gray-400"
        style="opacity:0"
      >
        {siteConfig.tagline}
      </p>
    </div>
  </div>
  <div
    id="hero-socials"
    class="absolute bottom-0 left-0 right-0 p-8 sm:p-12 md:p-24 flex gap-x-4 sm:gap-x-6 md:gap-x-8 text-gray-400"
  >
    {
      siteConfig.social?.linkedin && (
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
          style="opacity:0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M8 11v5" />
              <path d="M8 8v.01" />
              <path d="M12 16v-5" />
              <path d="M16 16v-3a2 2 0 1 0 -4 0" />
              <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
            </>
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.twitter && (
        <a
          href={siteConfig.social.twitter}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
          style="opacity:0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
            </>
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.github && (
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
          style="opacity:0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
            </>
          </svg>
        </a>
      )
    }
  </div>
</div>

<script>
  import { animate, stagger } from "motion";

  const easeOut = [0.16, 1, 0.3, 1];

  // Animated glyph field, à la motion.dev's homepage gradient field —
  // same engineering-notation vocabulary as before, now with a slow
  // traveling brightness wave instead of a static tint.
  (function heroField() {
    const canvas = document.getElementById("hero-field");
    const heroEl = document.getElementById("hero");
    if (!canvas || !heroEl) return;
    const ctx = canvas.getContext("2d");

    const hex = (canvas.dataset.accent || "#b026ff").replace("#", "");
    const r = parseInt(hex.slice(0, 2), 16);
    const g = parseInt(hex.slice(2, 4), 16);
    const b = parseInt(hex.slice(4, 6), 16);

    const SYMBOLS = [
      "⌀12", "R5", "±0.05", "M4x0.7", "45°", "⌀8",
      "Ra 0.8", "kPa", "⊥", "0.6J", "M3", "⌀6", "R2",
      "±0.1", "GD&T", "N·m", "IP67", "5-axis",
    ];

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let width = 0;
    let height = 0;
    let glyphs = [];

    function layout() {
      const rect = heroEl.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + "px";
      canvas.style.height = height + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const cols = Math.max(6, Math.round(width / 170));
      const rows = Math.max(4, Math.round(height / 170));
      glyphs = [];
      let i = 0;
      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < cols; col++) {
          const jitterX = Math.sin(i * 12.9898) * 45;
          const jitterY = Math.cos(i * 78.233) * 45;
          glyphs.push({
            x: (col + 0.5) * (width / cols) + jitterX,
            y: (row + 0.5) * (height / rows) + jitterY,
            text: SYMBOLS[i % SYMBOLS.length],
            size: 13 + (i % 3) * 4,
            rot: ((i * 47) % 60) - 30,
            phase: ((i * 0.6) % (Math.PI * 2)) * 0.15,
          });
          i++;
        }
      }
    }

    function draw(t) {
      ctx.clearRect(0, 0, width, height);
      for (const gl of glyphs) {
        const wave = Math.sin(
          (gl.x + gl.y) * 0.005 + t * Math.PI * 2 + gl.phase
        );
        const bright = (wave + 1) / 2;
        const alpha = 0.08 + bright * 0.34;
        ctx.save();
        ctx.translate(gl.x, gl.y);
        ctx.rotate((gl.rot * Math.PI) / 180);
        ctx.font = `${gl.size}px monospace`;
        ctx.textBaseline = "middle";
        ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
        ctx.fillText(gl.text, 0, 0);
        ctx.restore();
      }
    }

    layout();
    draw(0);
    window.addEventListener("resize", layout);

    if (!reduceMotion) {
      animate(0, 1, {
        duration: 9,
        repeat: Infinity,
        easing: "linear",
        onUpdate: draw,
      });
    }
  })();

  animate(
    "#hero-name",
    { opacity: [0, 1], y: [28, 0] },
    { duration: 0.9, easing: easeOut }
  );
  animate(
    "#hero-tagline",
    { opacity: [0, 1], y: [16, 0] },
    { duration: 0.8, delay: 0.3, easing: easeOut }
  );
  animate(
    "#hero-socials a",
    { opacity: [0, 1], y: [10, 0] },
    { duration: 0.6, delay: stagger(0.08, { start: 0.55 }), easing: easeOut }
  );

  // Slow ambient "breathing" glow behind the name
  animate(
    "#hero-glow",
    { opacity: [0.75, 1, 0.75], scale: [1, 1.06, 1] },
    { duration: 7, repeat: Infinity, easing: "ease-in-out" }
  );
</script>
