---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-[#0a0a0a] py-24 md:h-screen"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <!-- Base -->
  <div class="absolute inset-0 -z-20 bg-[#0a0a0a]"></div>

  <!-- Animated wireframe grid floor -->
  <canvas
    id="hero-grid"
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full [mask-image:linear-gradient(to_bottom,transparent_0%,black_35%)]"
  ></canvas>

  <div
    class="h-full mx-auto p-8 sm:p-12 md:p-24 flex items-center relative z-10"
  >
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <div class="lg:col-span-7">
        <h1
          id="hero-name"
          class="text-pretty text-5xl sm:text-6xl md:text-7xl lg:text-9xl font-bold tracking-tighter text-white"
          style="opacity:0"
        >
          I'm <span style={{ color: siteConfig.accentColor }}
            >{siteConfig.firstName}</span
          >
        </h1>
        <p
          id="hero-tagline"
          class="mt-4 sm:mt-6 md:mt-8 text-pretty text-base sm:text-lg md:text-xl/8 font-medium text-gray-400"
          style="opacity:0"
        >
          {siteConfig.tagline}
        </p>
      </div>

      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div
          id="hero-photos"
          class="relative"
          style="opacity:0; perspective:1200px"
        >
          <div
            id="hero-photo-stack"
            class="relative w-[260px] sm:w-[320px] md:w-[370px] lg:w-[420px]"
            style="will-change: transform"
          >
            <!-- violet glow -->
            <div
              class="absolute -inset-6 sm:-inset-10 rounded-[2rem] blur-2xl -z-10"
              style="background: radial-gradient(circle, var(--accent-color) 0%, transparent 70%); opacity:0.5"
            >
            </div>

            <!-- main photo, violet gradient ring -->
            <div
              class="relative aspect-[4/5] rounded-2xl p-[3px]"
              style="background: linear-gradient(155deg, var(--accent-color), rgba(176,38,255,0) 65%)"
            >
              <div class="w-full h-full rounded-[calc(1rem-1px)] overflow-hidden bg-black">
                <img
                  src="/media/photos/jonah-conference.jpg"
                  alt={`${siteConfig.firstName} presenting his work at Microfluidic Horizons 2026`}
                  class="w-full h-full object-cover"
                  width="640"
                  height="800"
                />
              </div>
            </div>

            <!-- secondary photo, offset + smaller -->
            <div
              id="hero-photo-secondary"
              class="absolute -bottom-8 -left-10 sm:-bottom-10 sm:-left-14 w-[120px] sm:w-[155px] md:w-[180px] aspect-[2/3] rounded-xl overflow-hidden border border-white/15 shadow-2xl bg-black z-10"
              style="transform: rotate(-6deg)"
            >
              <img
                src="/media/photos/jonah-silly2.jpg"
                alt={`${siteConfig.firstName} filming with a camera at night`}
                class="w-full h-full object-cover"
                width="400"
                height="600"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    id="hero-socials"
    class="absolute bottom-0 left-0 right-0 p-8 sm:p-12 md:p-24 flex gap-x-4 sm:gap-x-6 md:gap-x-8 text-gray-400 z-10"
  >
    {
      siteConfig.social?.linkedin && (
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
          style="opacity:0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M8 11v5" />
              <path d="M8 8v.01" />
              <path d="M12 16v-5" />
              <path d="M16 16v-3a2 2 0 1 0 -4 0" />
              <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
            </>
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.twitter && (
        <a
          href={siteConfig.social.twitter}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
          style="opacity:0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
            </>
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.github && (
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
          style="opacity:0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
            </>
          </svg>
        </a>
      )
    }
  </div>
</div>

<script>
  import { animate, stagger } from "motion";

  const easeOut = [0.16, 1, 0.3, 1];
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  // Perspective grid floor converging on a horizon vanishing point, scrolling
  // toward the viewer — violet wireframe in place of the old static blobs.
  const canvas = document.getElementById("hero-grid") as HTMLCanvasElement;
  const hero = document.getElementById("hero") as HTMLElement;

  if (canvas && hero) {
    const ctx = canvas.getContext("2d")!;
    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);

    function resize() {
      width = hero.clientWidth;
      height = hero.clientHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    window.addEventListener("resize", resize);

    const horizonRatio = 0.42;
    const cols = 22;
    const rows = 16;
    const speed = reduceMotion ? 0 : 0.07;

    function drawGrid(offset: number) {
      ctx.clearRect(0, 0, width, height);
      const horizonY = height * horizonRatio;
      const centerX = width / 2;
      const halfSpan = width * 0.9;

      // Verticals converging toward the vanishing point.
      for (let i = -cols; i <= cols; i++) {
        const xBottom = centerX + (i / cols) * halfSpan;
        const xHorizon = centerX + (i / cols) * halfSpan * 0.035;
        const t = Math.abs(i) / cols;
        ctx.strokeStyle = `rgba(176, 38, 255, ${0.16 * (1 - t * 0.6)})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(xHorizon, horizonY);
        ctx.lineTo(xBottom, height);
        ctx.stroke();
      }

      // Horizontals scrolling toward the viewer, denser near the horizon.
      for (let j = 0; j < rows; j++) {
        const raw = (j / rows + offset) % 1;
        const t = Math.pow(raw, 2.4);
        const y = horizonY + t * (height - horizonY);
        const rowHalfSpan = halfSpan * (0.02 + t * 0.98);
        ctx.strokeStyle = `rgba(176, 38, 255, ${0.22 * raw})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(centerX - rowHalfSpan, y);
        ctx.lineTo(centerX + rowHalfSpan, y);
        ctx.stroke();
      }
    }

    let offset = 0;
    let last = performance.now();
    function frame(now: number) {
      const dt = (now - last) / 1000;
      last = now;
      offset = (offset + dt * speed) % 1;
      drawGrid(offset);
      requestAnimationFrame(frame);
    }
    if (reduceMotion) {
      drawGrid(0);
    } else {
      requestAnimationFrame(frame);
    }
  }

  // Subtle pointer-follow tilt on the photo stack.
  const photoStack = document.getElementById("hero-photo-stack");
  const photoSecondary = document.getElementById("hero-photo-secondary");

  if (photoStack && hero && !reduceMotion) {
    let targetX = 0;
    let targetY = 0;
    let curX = 0;
    let curY = 0;

    hero.addEventListener("pointermove", (e) => {
      const rect = hero.getBoundingClientRect();
      targetX = (e.clientX - rect.left) / rect.width - 0.5;
      targetY = (e.clientY - rect.top) / rect.height - 0.5;
    });
    hero.addEventListener("pointerleave", () => {
      targetX = 0;
      targetY = 0;
    });

    function tiltLoop() {
      curX += (targetX - curX) * 0.08;
      curY += (targetY - curY) * 0.08;
      photoStack.style.transform = `rotateY(${curX * 12}deg) rotateX(${-curY * 12}deg)`;
      if (photoSecondary) {
        photoSecondary.style.transform = `rotate(-6deg) translate(${curX * 16}px, ${curY * 16}px)`;
      }
      requestAnimationFrame(tiltLoop);
    }
    requestAnimationFrame(tiltLoop);
  }

  animate(
    "#hero-name",
    { opacity: [0, 1], y: [28, 0] },
    { duration: 0.9, easing: easeOut }
  );
  animate(
    "#hero-tagline",
    { opacity: [0, 1], y: [16, 0] },
    { duration: 0.8, delay: 0.3, easing: easeOut }
  );
  animate(
    "#hero-photos",
    { opacity: [0, 1], y: [24, 0], scale: [0.96, 1] },
    { duration: 0.9, delay: 0.35, easing: easeOut }
  );
  animate(
    "#hero-socials a",
    { opacity: [0, 1], y: [10, 0] },
    { duration: 0.6, delay: stagger(0.08, { start: 0.55 }), easing: easeOut }
  );
</script>
