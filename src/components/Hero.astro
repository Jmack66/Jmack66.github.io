---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-[#0a0a0a] py-24 md:h-screen"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <!-- Base -->
  <div class="absolute inset-0 -z-10 bg-[#0a0a0a]"></div>

  <!-- Animated gradient field -->
  <div
    id="hero-field"
    aria-hidden="true"
    class="absolute inset-0 -z-10 overflow-hidden"
  >
    <div
      class="hero-blob"
      style="width:70vw;height:70vw;left:-15vw;top:-20vw;background:radial-gradient(circle, #b026ff 0%, transparent 70%)"
    >
    </div>
    <div
      class="hero-blob"
      style="width:55vw;height:55vw;right:-10vw;top:10vh;background:radial-gradient(circle, #6d28d9 0%, transparent 70%)"
    >
    </div>
    <div
      class="hero-blob"
      style="width:50vw;height:50vw;left:20vw;bottom:-25vh;background:radial-gradient(circle, #d946ef 0%, transparent 70%)"
    >
    </div>
  </div>

  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-white/10 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
  >
    <defs>
      <pattern
        x="50%"
        y={-1}
        id="0787a7c5-978c-4f66-83c7-11c213f99cb7"
        width={200}
        height={200}
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 200V.5H200" fill="none"></path>
      </pattern>
    </defs>
    <rect
      fill="url(#0787a7c5-978c-4f66-83c7-11c213f99cb7)"
      width="100%"
      height="100%"
      stroke-width={0}></rect>
  </svg>
  <div class="h-full mx-auto p-8 sm:p-12 md:p-24 flex items-center">
    <div>
      <h1
        id="hero-name"
        class="text-pretty text-5xl sm:text-6xl md:text-7xl lg:text-9xl font-bold tracking-tighter text-white"
        style="opacity:0"
      >
        I'm <span style={{ color: siteConfig.accentColor }}
          >{siteConfig.firstName}</span
        >
      </h1>
      <p
        id="hero-tagline"
        class="mt-4 sm:mt-6 md:mt-8 text-pretty text-base sm:text-lg md:text-xl/8 font-medium text-gray-400"
        style="opacity:0"
      >
        {siteConfig.tagline}
      </p>
    </div>
  </div>
  <div
    id="hero-socials"
    class="absolute bottom-0 left-0 right-0 p-8 sm:p-12 md:p-24 flex gap-x-4 sm:gap-x-6 md:gap-x-8 text-gray-400"
  >
    {
      siteConfig.social?.linkedin && (
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
          style="opacity:0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M8 11v5" />
              <path d="M8 8v.01" />
              <path d="M12 16v-5" />
              <path d="M16 16v-3a2 2 0 1 0 -4 0" />
              <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
            </>
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.twitter && (
        <a
          href={siteConfig.social.twitter}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
          style="opacity:0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
            </>
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.github && (
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
          style="opacity:0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
            </>
          </svg>
        </a>
      )
    }
  </div>
</div>

<script>
  import { animate, stagger } from "motion";

  const easeOut = [0.16, 1, 0.3, 1];

  // Slow-drifting gradient field, à la motion.dev's homepage — three
  // blurred blobs in shades of purple, each drifting on its own loop.
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (!reduceMotion) {
    const blobs = document.querySelectorAll(".hero-blob");
    const drifts = [
      { x: [0, 60, -30, 0], y: [0, -40, 30, 0], duration: 22 },
      { x: [0, -50, 40, 0], y: [0, 50, -20, 0], duration: 26 },
      { x: [0, 40, -60, 0], y: [0, -30, 20, 0], duration: 30 },
    ];
    blobs.forEach((blob, i) => {
      const d = drifts[i % drifts.length];
      animate(
        blob,
        { x: d.x, y: d.y, scale: [1, 1.15, 0.95, 1] },
        { duration: d.duration, repeat: Infinity, easing: "ease-in-out" }
      );
    });
  }

  animate(
    "#hero-name",
    { opacity: [0, 1], y: [28, 0] },
    { duration: 0.9, easing: easeOut }
  );
  animate(
    "#hero-tagline",
    { opacity: [0, 1], y: [16, 0] },
    { duration: 0.8, delay: 0.3, easing: easeOut }
  );
  animate(
    "#hero-socials a",
    { opacity: [0, 1], y: [10, 0] },
    { duration: 0.6, delay: stagger(0.08, { start: 0.55 }), easing: easeOut }
  );
</script>

<style>
  .hero-blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(70px);
    opacity: 0.55;
    mix-blend-mode: screen;
    will-change: transform;
  }
</style>
